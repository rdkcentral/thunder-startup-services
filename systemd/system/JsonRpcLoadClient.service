[Unit]
Description=ES1 configurable load client (on-demand)
Requires=wpeframework.service
Requires=wpeframework-es1benchmark.service
After=wpeframework.service wpeframework-es1benchmark.service
ConditionPathExists=/tmp/wpeframeworkstarted

[Service]
Type=oneshot
ExecStart=/bin/sh -c '/usr/bin/JsonRpcLoadClient /opt/JsonRpcLoadClient.config >> /opt/es1bench/log/JsonRpcLoadClient.jsonl 2>> /opt/es1bench/log/JsonRpcLoadClient.exchange.log'
ExecStartPost=/bin/sh -c 'printf "JsonRpcLoadClient summary:\n"; cat /opt/es1bench/log/JsonRpcLoadClient.jsonl; printf "JsonRpcLoadClient exchange:\n"; cat /opt/es1bench/log/JsonRpcLoadClient.exchange.log'
StandardOutput=journal
StandardError=journal
