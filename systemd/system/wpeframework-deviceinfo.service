[Unit]
Description=WPEFramework DeviceInfo Initialiser
Requires=wpeframework.service iarmbusd.service dsmgr.service wpeframework-devicesettings.service
After=wpeframework.service iarmbusd.service dsmgr.service wpeframework-devicesettings.service
ConditionPathExists=/tmp/wpeframeworkstarted
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/PluginActivator DeviceInfo
