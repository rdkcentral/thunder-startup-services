[Unit]
Description=ES1Bench Client (on-demand, run after Thunder is up)
Requires=wpeframework.service
After=wpeframework.service
ConditionPathExists=/tmp/wpeframeworkstarted

[Service]
Type=oneshot
# Redirection done in the shell, not via StandardOutput=append: - that
# systemd file-specifier syntax needs systemd v240+, which this device's
# systemd predates (confirmed via "Failed to parse output specifier" in the
# journal). A plain shell >> works on any systemd version.
ExecStart=/bin/sh -c '/usr/bin/es1client /opt/es1.config >> /opt/es1bench/log/results.jsonl'
StandardError=journal
