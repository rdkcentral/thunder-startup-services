[Unit]
Description=WPEFramework AppPackageManager Initialiser
Requires= wpeframework.service wpeframework-appstoragemanager.service
After= wpeframework.service wpeframework-appstoragemanager.service
ConditionPathExists=/etc/rdkappmanagers
ConditionPathExists=/tmp/wpeframeworkstarted

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/PluginActivator org.rdk.AppPackageManager

