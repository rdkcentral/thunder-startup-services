[Unit]
Description=WPEFramework FrontPanel Initialiser
Requires=wpeframework-powermanager.service dsmgr.service wpeframework-devicesettings.service
After=wpeframework-powermanager.service dsmgr.service wpeframework-devicesettings.service
ConditionPathExists=/tmp/wpeframeworkstarted
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/PluginActivator org.rdk.FrontPanel
