[Unit]
Description=WPEFramework Account Initialiser
Requires=wpeframework.service wpeframework-wpetelemetry.service
After=wpeframework.service wpeframework-wpetelemetry.service
ConditionPathExists=/tmp/wpeframeworkstarted
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/PluginActivator org.rdk.Account
