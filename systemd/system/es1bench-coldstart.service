[Unit]
Description=ES1Bench Client (cold-start capture, runs before Thunder)
Before=wpeframework.service

[Service]
Type=simple
# Redirection done in the shell, not via StandardOutput=append: - that
# systemd file-specifier syntax needs systemd v240+, which this device's
# systemd predates (confirmed via "Failed to parse output specifier" in the
# journal, on the on-demand unit - same systemd, same limitation here). A
# plain shell >> works on any systemd version.
ExecStart=/bin/sh -c '/usr/bin/es1client /opt/es1-coldstart.config >> /opt/es1bench/log/coldstart.jsonl'
StandardError=journal
