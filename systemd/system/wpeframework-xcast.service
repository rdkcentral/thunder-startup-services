[Unit]
Description=WPEFramework Xcast Initialiser
Requires=wpeframework-powermanager.service wpeframework-system.service wpeframework-networkmanager.service 
After=wpeframework-powermanager.service wpeframework-system.service wpeframework-networkmanager.service 
ConditionPathExists=/tmp/wpeframeworkstarted
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/PluginActivator org.rdk.Xcast
