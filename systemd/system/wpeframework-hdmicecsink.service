[Unit]
Description=WPEFramework HdmiCecSink Initialiser
Requires=wpeframework-powermanager.service wpeframework-usersettings.service wpeframework-devicesettings.service
After=wpeframework-powermanager.service wpeframework-usersettings.service wpeframework-devicesettings.service
ConditionPathExists=/tmp/wpeframeworkstarted
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/PluginActivator org.rdk.HdmiCecSink
